+test('paced partial submits upload only new arena bytes, keep offsets and resume the pass',()=>{
+  globalThis.GPUBufferUsage={COPY_DST:1,VERTEX:2,INDEX:4};
+  const events=[];
+  const engine=Object.assign(Object.create(WebGPUEngine.prototype),{
+    uniformCapacity:1024,uniformCursor:0,uniformHost:new Uint8Array(1024),uniformBuffer:'uniform',
+    device:{limits:{minUniformBufferOffsetAlignment:256},createBuffer:()=> 'vertex',
+      queue:{writeBuffer(buffer,offset,bytes){events.push({buffer,offset,bytes:[...bytes]});},submit(list){events.push(['submit',...list]);}}},
+    transientArenas:{vertex:[],index:[]},encoder:{finish:()=> 'first'},
+    retired:new Set(),objects:new Map(),stats:{submissions:0,uploadBytes:0},report(){},
+    pass:{},target:'framebuffer',
+    endFramebuffer(){events.push('end');this.pass=null;},
+    beginFramebuffer(target,load){events.push(['begin',target,load]);this.encoder={finish:()=> 'second'};this.pass={};}
+  });
+  const bytes=new Uint8Array([1,2,3,4]);
+  const shader={group0:{},variant:{uniforms:[{binding:0}],textures:[]},uniformBlocks:new Map([[0,bytes]]),uniformSnapshots:new Map()};
+  const offsets=[],pass=()=>({setBindGroup(group,binding,values){offsets.push([...values]);}});
+  engine.bindShader(pass(),shader);engine.uploadTransient('vertex',new Uint8Array([9,10,11,12]));
+  assert.equal(engine.flushWork(),true);
+  assert.deepEqual(events,['end',{buffer:'uniform',offset:0,bytes:[1,2,3,4]},
+    {buffer:'vertex',offset:0,bytes:[9,10,11,12]},['submit','first'],['begin','framebuffer',true]]);
+  // The resumed pass reuses the uploaded block; later data appends at its own offset.
+  events.length=0;engine.bindShader(pass(),shader);engine.uploadTransient('vertex',new Uint8Array([13,14,15,16]));
+  engine.pass=null;engine.submit();
+  assert.deepEqual(offsets,[[0],[0]]);
+  assert.deepEqual(events,[{buffer:'vertex',offset:4,bytes:[13,14,15,16]},['submit','second']]);
+  assert.equal(engine.uniformCursor,0);assert.equal(engine.transientArenas.vertex[0].cursor,0);
+  assert.equal(engine.stats.partialSubmissions,1);assert.equal(engine.stats.submissions,1);
+  // The next frame starts again at offset zero with a new snapshot.
+  events.length=0;engine.encoder={finish:()=> 'next'};engine.bindShader(pass(),shader);engine.submit();
+  assert.deepEqual(events,[{buffer:'uniform',offset:0,bytes:[1,2,3,4]},['submit','next']]);
+  assert.equal(engine.flushWork(),false,'nothing recorded since the last submit');
+});
