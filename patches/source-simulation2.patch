+        JS::HandleValue strengthValue, JS::HandleValue maximumValue, int type)
+    {
+        for (JS::HandleValue v : {widthValue, heightValue, cxValue, cyValue, distanceValue, strengthValue, maximumValue})
+            if (!v.isNumber()) return false;
+        const double widthNumber = widthValue.toNumber(), heightNumber = heightValue.toNumber();
+        if (!std::isfinite(widthNumber) || std::floor(widthNumber) != widthNumber ||
+            !std::isfinite(heightNumber) || std::floor(heightNumber) != heightNumber ||
+            widthNumber <= 0 || widthNumber > 32768) return false;
+        const int width = widthNumber;
+        const double cx = cxValue.toNumber(), cy = cyValue.toNumber(), distance = distanceValue.toNumber();
+        const double strength = strengthValue.toNumber(), maximum = maximumValue.toNumber();
+        if (!value.isObject() ||
+            !std::isfinite(cx) || !std::isfinite(cy) || !std::isfinite(distance) ||
+            !std::isfinite(strength) || !std::isfinite(maximum) || distance <= 0 ||
