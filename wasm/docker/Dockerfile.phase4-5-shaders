FROM 0ad-wasm-phase4-5:toolchain
ENV CARGO_BUILD_JOBS=2
RUN apt-get update && apt-get install -y --no-install-recommends glslc=2023.8-1build1 spirv-cross=2021.01.15+1.3.239.0-1build1 spirv-tools=2025.1~rc1-1~ubuntu0.24.04.2 \
    && rm -rf /var/lib/apt/lists/*
RUN cargo install naga-cli --version 24.0.0 --locked --root /opt/naga
ENV PATH=/opt/naga/bin:$PATH
RUN mkdir -p /phase45-tools && dpkg-query -W glslc spirv-cross spirv-tools > /phase45-tools/packages.tsv \
    && sha256sum /usr/bin/glslc /usr/bin/spirv-cross /usr/bin/spirv-val /opt/naga/bin/naga > /phase45-tools/binaries.sha256
